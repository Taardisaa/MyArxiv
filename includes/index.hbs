<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>{{site_title}}</title>
<link rel="icon" href="favicon.ico"><link rel="stylesheet" href="index.css?v=2">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.15.1/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.15.1/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.15.1/dist/contrib/auto-render.min.js"></script>
<script defer src="index.js?v=2"></script>
</head>
<body>
<div class="shell">
<header class="masthead"><a class="brand" href="./"><span class="brand-mark">a</span> MyArxiv<span class="brand-note"> / personal reading desk</span></a><button id="theme-toggle" type="button" aria-label="Switch color theme">Dark mode</button></header>
<section class="intro"><div class="eyebrow">GPU SECURITY / RESEARCH DESK</div><h1>GPU Security</h1><p>Side channels, confidential computing, and GPU isolation.<br class="desktop-break"> A keyword-filtered shelf · last 90 days · at most 60 papers.</p><div class="collection-meta"><span id="collection-count">Recent papers</span><span class="dot">·</span><span id="collection-dates"></span></div></section>
<main>
<section class="toolbar" aria-label="Filter papers">
<div class="search-row"><label class="search-wrap"><span aria-hidden="true">⌕</span><span class="sr-only">Search papers</span><input id="search" type="search" placeholder="Search titles, authors, abstracts…" autocomplete="off"></label><label class="range-wrap"><span class="sr-only">Date range</span><select id="date-range"><option value="all">All saved dates</option><option value="3">Latest 3 days</option><option value="1">Latest day</option></select></label></div>
<div id="topic-filters" class="topic-filters" aria-label="Topics"></div>
</section>
<div class="results-bar"><span id="results-count" role="status" aria-live="polite"></span><span>NEWEST FIRST</span></div>
<div id="papers">
{{#each days}}
<section class="day-group" data-date="{{time_format datetime "%F"}}"><h2><time datetime="{{datetime}}">{{time_format datetime "%F"}}</time></h2>
{{#each subjects}}
{{#each papers}}
<article class="paper" data-topic="{{../subject}}">
<div class="paper-meta"><span class="topic-label">{{../subject}}</span>{{#if (ne updated published)}}<span class="revision">Revised</span>{{/if}}</div>
<details><summary><span class="paper-title">{{title}}</span><span class="expand-symbol" aria-hidden="true">+</span></summary><div class="abstract"><h3>Abstract</h3><p>{{summary}}</p>{{#if comment}}<p class="comment">{{comment}}</p>{{/if}}</div></details>
<div class="paper-bottom"><div class="authors">{{#each authors}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div><div class="paper-links"><a href="{{id}}" target="_blank" rel="noopener noreferrer">arXiv ↗</a><a href="{{pdf_url}}" target="_blank" rel="noopener noreferrer">PDF ↗</a></div></div>
</article>
{{/each}}
{{/each}}
</section>
{{/each}}
</div>
<div id="empty-state" hidden><h2>No papers found.</h2><p>Try another keyword or choose a different topic.</p><button id="reset-filters" type="button">Clear filters</button></div>
<div class="load-more-wrap"><button id="load-more" type="button" hidden>Show more papers</button><p id="page-count"></p></div>
</main>
<footer><span>MyArxiv · Your personal research shelf</span><span>Snapshot <time datetime="{{build_time}}">{{time_format build_time "%F"}}</time></span></footer>
</div>
</body></html>
